# Canonical hostname. It is the name in every SSH clone URL, and the name the web UI
# is reached by from outside the LAN.
GIT_DOMAIN=git.example.com

# LAN hostname served by the reverse proxy. Every link, redirect and displayed HTTPS
# clone URL is built from it, and so is the container registry token realm, so it must
# resolve on every machine that pulls an image.
WEB_DOMAIN=git.lan.example.com
