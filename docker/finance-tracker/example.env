# Registry hosting the image. The name must resolve on this host, and is the same
# name CI pushes to.
REGISTRY=git.lan.example.com

# Login secrets. The app refuses to start without all three. The README says how to
# make them.
PASSWORD_HASH=
SESSION_SECRET=
API_TOKEN_HASH=

# Rollback knob. Set it to a build's short commit sha to pin that build, then remove
# the line again once latest is good: while it is set, every later CI deploy
# re-deploys the pinned build and still reports success.
#FINANCE_TRACKER_TAG=
