# Required since paperless-ngx v3. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it later invalidates existing sessions and signed tokens.
PAPERLESS_SECRET_KEY=

# Public URL, required when serving paperless behind a reverse proxy.
# Leave empty if reaching it directly on the host port.
PAPERLESS_URL=

DATA_LOCATION=./appdata/paperless/data
MEDIA_LOCATION=./appdata/paperless/media
EXPORT_LOCATION=./appdata/paperless/export
CONSUME_LOCATION=./appdata/paperless/consume
