# Blacksmith-only config. Copy to blacksmith.env (gitignored) and fill in.
# Kept separate from .env so these values never enter the Immich containers.

# Immich API key used by Blacksmith
IMMICH_API_KEY=

COMFYUI_URL=http://comfyui:8188

# In-app auth: the token is the browser login password AND the bearer token
# for the mobile app / widget / scripts. Empty or unset = auth DISABLED
# (loud boot warning).
BLACKSMITH_AUTH_TOKEN=
# >=32-char random key that seals the browser session cookie.
# Generate with: openssl rand -base64 32
BLACKSMITH_SESSION_PASSWORD=
